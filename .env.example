# ==============================================================================
# Amahle Blue / Maxwell — Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & CLOUD STORAGE
# ------------------------------------------------------------------------------
# MongoDB Connection String (for data storage/backup)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0"

# Vercel KV / Upstash Redis (Used for fast cloud data storage & caching in api/_blob.js)
KV_REST_API_URL="https://your-kv-db.upstash.io"
KV_REST_API_TOKEN="your-kv-rest-api-token"

# Vercel Blob Read/Write Token (Used for product images, videos & proof of payments in api/upload.js & api/proof.js)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECRETS
# ------------------------------------------------------------------------------
# Secret key used for signing & verifying Admin session JWT tokens (min 32 characters)
ADMIN_JWT_SECRET="your-32-byte-hex-or-random-admin-jwt-secret"

# Secret key used for signing & verifying Customer session JWT tokens and OTP codes (min 32 characters)
CUSTOMER_JWT_SECRET="your-32-byte-hex-or-random-customer-jwt-secret"

# ------------------------------------------------------------------------------
# 3. ADMIN & MANAGER CREDENTIALS
# ------------------------------------------------------------------------------
# Note: Generate password hashes with: node scripts/hash-password.js "<your-password>"
# Salt used internally: ab_salt_2024:

# Admin Account
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="272a64bd5b8180fd01c5783f480b3bd88e3a9892a34d11ec7e2f1bf03365d6f3"
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@amahle-blue.co.za"

# Manager Account (Optional)
MANAGER_USERNAME="manager"
MANAGER_PASSWORD_HASH="80e5ac2e6eb1c046af13aadd3b38ef4560a7be364ccc67c115965cf8e264fe28"
MANAGER_NAME="Manager"
MANAGER_EMAIL="manager@amahle-blue.co.za"

# Optional: Complete JSON array of admin credentials (overrides individual variables if provided)
# ADMIN_CREDS='[{"username":"admin","passwordHash":"...","role":"admin","name":"Admin","email":"admin@amahle-blue.co.za"}]'

# ------------------------------------------------------------------------------
# 4. EMAIL NOTIFICATIONS (Transactional & OTP)
# ------------------------------------------------------------------------------
# Resend API Key (Primary email provider for OTP codes, order confirmations, and notifications)
RESEND_API_KEY="re_123456789..."

# Sender email address (must be a verified domain in Resend)
FROM_EMAIL="Amahle Blue <noreply@amahle-blue.co.za>"

# Gmail SMTP Fallback (Used if Resend is not configured or fails)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# ------------------------------------------------------------------------------
# 5. VERCEL INTEGRATION & DEPLOYMENT
# ------------------------------------------------------------------------------
# Required for in-dashboard admin password change/rotation via Vercel Env API
VERCEL_PROJECT_ID="prj_93sJMJPoDyIR0wT2h6DqPax0HIKr"
VERCEL_TEAM_ID="team_FkInA0rM5VjIPRHruECFJ4R0"
VERCEL_API_TOKEN="your-vercel-personal-access-token"
