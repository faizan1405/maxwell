# Cloudinary — image hosting for category banner uploads.
# Required for admin category banner uploads.
# Real values must be added in .env.local for local development
# and in Vercel Project Settings → Environment Variables for production.
# Do not commit real secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth — customer sign-in ("Continue with Google").
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console and
# register these Authorized redirect URIs (must match AUTH_URL exactly):
#   http://localhost:3000/api/auth/google/callback   (local dev)
#   https://<your-prod-domain>/api/auth/google/callback   (production)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL is REQUIRED in production: the canonical public origin used to build
# the OAuth redirect_uri. We never trust the Host header in production, so the
# flow fails closed if this is unset. In local dev it may be omitted (localhost
# is derived automatically). Example: AUTH_URL=https://amahle-blue.co.za
AUTH_URL=

# SESSION_SECRET — REQUIRED. Random 32+ char string used to HMAC customer
# session tokens. There is no insecure fallback: sign-in and session
# verification fail closed if this is missing.
SESSION_SECRET=
